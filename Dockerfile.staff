# syntax=docker/dockerfile:1.7
#
# The staff site (staff.momentspackaging.com): this app built in staff mode, served by nginx on the VPS through Coolify.
# Staff mode comes from .env.staff (VITE_APP_MODE=staff) via --mode staff, and also from the staff.* hostname at run time.
# The API address is chosen in the code (src/config/api.ts: any *.momentspackaging.com host uses the production store API).
# No sitemap or prerender steps: the staff site is not for search engines.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,id=moments-shop-npm npm ci --no-audit --no-fund
COPY . .
RUN npx vite build --mode staff

FROM nginx:1.27-alpine
COPY deploy/staff-nginx/default.conf /etc/nginx/conf.d/default.conf
COPY deploy/staff-nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
